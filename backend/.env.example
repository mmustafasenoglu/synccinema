# SyncCinema Backend — Ortam Değişkenleri

# CORS izni verilen origin'ler (virgülle ayrılmış)
# Development: http://localhost:5173
# Production: https://cinema.algoforge.com.tr
ALLOWED_ORIGINS=http://localhost:5173

# Site giriş şifresi (opsiyonel — boş bırakılırsa auth ekranı.atlanır)
SITE_PASSWORD=

# Cloudflare TURN credentials
# Token: Cloudflare Dashboard > Workers & Pages > TURN key > API Token
CLOUDFLARE_TURN_TOKEN=
CLOUDFLARE_TURN_KEY_ID=1
