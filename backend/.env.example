# SyncCinema Backend — Ortam Değişkenleri

# Üretim (production) ortamında CORS'u kısıtlamak için bu değişkeni ayarla.
# Tanımlanmazsa geliştirme modunda tüm originlere (*) izin verilir.
ALLOWED_ORIGIN=https://senin-domain.com

# Cloudflare TURN credentials
CLOUDFLARE_TURN_TOKEN=your_token_here
CLOUDFLARE_ZONE_ID=your_zone_id_here
